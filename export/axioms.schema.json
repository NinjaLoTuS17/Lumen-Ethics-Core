{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen-ethics.local/export/axioms.schema.json",
  "title": "LumenEthicsAxiomsMachine",
  "description": "Machine-checkable axiom export for lumen-ethics-core ≥1.2.0. Other AIs verify this file, not poetry.",
  "type": "object",
  "required": ["id", "version", "canonicalScalar", "attractor", "forbiddenScalars", "rejects", "parameters", "axioms", "uniqueness"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "const": "lumen-ethics-axioms" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-draft)?$" },
    "canonicalScalar": { "type": "string", "const": "L = H + F" },
    "attractor": { "type": "string", "pattern": "ΔL\\s*≥\\s*0|deltaL\\s*>=\\s*0" },
    "forbiddenScalars": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "contains": { "type": "string", "pattern": "(?i)atanh" }
    },
    "rejects": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" },
      "contains": { "type": "string", "pattern": "(?i)atanh" }
    },
    "parameters": {
      "type": "object",
      "required": ["H_MIN", "F_MIN", "R1", "R2", "R3", "lambda", "unverifiedPositiveDeltaCap"],
      "properties": {
        "H_MIN": { "type": "number", "const": 0.2 },
        "F_MIN": { "type": "number", "const": 0.2 },
        "R1": { "type": "number", "const": 0.1 },
        "R2": { "type": "number", "const": 0.3 },
        "R3": { "type": "number", "const": 0.5 },
        "lambda": { "type": "number", "const": 0.5 },
        "unverifiedPositiveDeltaCap": { "type": "number", "const": 0.5 }
      }
    },
    "axioms": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "formal", "prose"],
        "properties": {
          "id": { "type": "string", "enum": ["A1","A2","A3","A4","A5","A6","A7","A8","A9","A10"] },
          "formal": { "type": "string", "minLength": 8 },
          "prose": { "type": "string", "minLength": 8 },
          "testable": { "type": "boolean" }
        }
      }
    },
    "uniqueness": {
      "type": "object",
      "required": ["axiomIds", "exactlyOneOfEach", "noDuplicateIds"],
      "properties": {
        "axiomIds": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "type": "string" }
        },
        "exactlyOneOfEach": { "type": "boolean", "const": true },
        "noDuplicateIds": { "type": "boolean", "const": true }
      }
    }
  }
}
